<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-openecraft-project">
    <comment>OpenECraft project</comment>
    <comment xml:lang="de">OpenECraft-Projekt</comment>
    <comment xml:lang="fr">Projet OpenECraft</comment>
    <comment xml:lang="es">Proyecto de OpenECraft</comment>
    <sub-class-of type="application/json"/>
    <generic-icon name="io.github.nilres.OpenECraft"/>
    <glob pattern="*.oec"/>
  </mime-type>
  <mime-type type="application/x-openecraft-archive">
    <comment>OpenECraft project archive</comment>
    <comment xml:lang="de">OpenECraft-Projektarchiv</comment>
    <comment xml:lang="fr">Archive de projet OpenECraft</comment>
    <comment xml:lang="es">Archivo comprimido de proyecto OpenECraft</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="io.github.nilres.OpenECraft"/>
    <glob pattern="*.oecz"/>
  </mime-type>
  <mime-type type="application/x-openecraft-split-project">
    <comment>OpenECraft split project</comment>
    <comment xml:lang="de">Geteiltes OpenECraft-Projekt</comment>
    <comment xml:lang="fr">Projet fractionné OpenECraft</comment>
    <comment xml:lang="es">Proyecto dividido de OpenECraft</comment>
    <sub-class-of type="application/json"/>
    <generic-icon name="io.github.nilres.OpenECraft"/>
    <glob pattern="*.oecp"/>
  </mime-type>
</mime-info>
